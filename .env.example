# Copy to .env and replace these placeholders; never commit .env.
RELAY_DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/relay?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&sslMode=REQUIRED
RELAY_DB_USERNAME=relay
RELAY_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
RELAY_AUTH_PUBLIC_ORIGIN=https://relay.example.com
RELAY_AUTH_SECURE_COOKIE=true

# SMTP STARTTLS on port 587 is configured by compose.yaml.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=relay@example.com
SPRING_MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
RELAY_MAIL_FROM=Relay <relay@example.com>

# Optional: images require a private Alibaba Cloud OSS bucket and exact-origin CORS.
RELAY_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
RELAY_OSS_UPLOAD_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
RELAY_OSS_REGION=cn-hangzhou
RELAY_OSS_BUCKET=
RELAY_OSS_ACCESS_KEY_ID=
RELAY_OSS_ACCESS_KEY_SECRET=
RELAY_OSS_SECURITY_TOKEN=
RELAY_OSS_PREFIX=relay-prod/
