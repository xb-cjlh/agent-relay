server.address=127.0.0.1
server.port=8765
relay.data=/var/lib/relay
spring.datasource.url=jdbc:mysql://YOUR_MYSQL_HOST:3306/relay?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&sslMode=REQUIRED&connectTimeout=5000&socketTimeout=20000
spring.datasource.username=relay
spring.datasource.password=CONFIGURE_ON_SERVER
relay.auth.public-origin=https://relay.example.com
relay.auth.secure-cookie=true
spring.mail.host=smtp.example.com
spring.mail.port=587
spring.mail.username=relay@example.com
spring.mail.password=CONFIGURE_ON_SERVER
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
relay.mail.from=Relay <relay@example.com>
relay.downloads=/opt/relay/downloads
relay.oss.endpoint=https://oss-cn-hangzhou-internal.aliyuncs.com
relay.oss.upload-endpoint=https://oss-cn-hangzhou.aliyuncs.com
relay.oss.region=cn-hangzhou
relay.oss.bucket=YOUR_PRIVATE_BUCKET
relay.oss.access-key-id=SERVER_ONLY
relay.oss.access-key-secret=SERVER_ONLY
relay.oss.security-token=
relay.oss.prefix=relay-prod/
