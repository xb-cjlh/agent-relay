[Unit]
Description=Relay agent manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
WorkingDirectory=/var/lib/relay
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:+ExitOnOutOfMemoryError -jar /opt/relay/current/relay-server.jar --spring.config.additional-location=file:/etc/relay/application.properties
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=640M
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
